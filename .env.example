# Copy to .env, or run: uv run python scripts/init_env.py
# Three DIFFERENT random tokens, each at least 32 characters; init_env.py generates them.
BUNBIRD_BRIDGE_TOKEN=
BUNBIRD_WORKER_TOKEN=
BUNBIRD_ADMIN_TOKEN=
BUNBIRD_CONTROL_URL=http://127.0.0.1:8080

# Enterprise self-built application, NOT a group webhook bot.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_KEY=
FEISHU_DOMAIN=https://open.feishu.cn
# Optional comma-separated chat IDs; empty allows chats inside the configured tenant.
FEISHU_ALLOWED_CHAT_IDS=
FEISHU_SPOOL_PATH=data/feishu-inbox.db

# mock is explicit connection-testing mode; replies are clearly marked as demonstrations.
# Use compatible for chat/completions, or anthropic for Anthropic Messages APIs.
MODEL_MODE=mock
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=

# Used by Compose PostgreSQL; init_env.py generates a random password.
DATABASE_PASSWORD=
